GEMINI_API_KEY=your_key_here

# Optional overrides — Gemini model IDs move fast; check
# https://ai.google.dev/gemini-api/docs/models before a demo and bump these
# if the pinned versions below have been deprecated.
# Pass A (transcription) is mechanical -> Flash tier is fine.
# Passes B/C/D are reasoning-heavy -> use the Pro tier.
GEMINI_FLASH_MODEL=gemini-3.7-flash
GEMINI_PRO_MODEL=gemini-3.1-pro-preview

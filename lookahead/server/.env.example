# Postgres connection. On Supabase use the project's connection string (Settings → Database).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lookahead
PORT=4000
# Public URL of the web app, used in emails and foreman confirm links.
APP_URL=http://localhost:5173

# AUTH_MODE=supabase verifies Supabase access tokens; AUTH_MODE=dev lets you pick a seeded user (local only).
AUTH_MODE=dev
SUPABASE_URL=
# Legacy HS256 JWT secret (Supabase → Settings → API). If empty, tokens are verified against SUPABASE_URL's JWKS.
SUPABASE_JWT_SECRET=

# Email (FR-05). Leave SMTP_HOST empty to log emails to the console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Lookahead <no-reply@example.com>"

# Hourly escalation scheduler; runs each project's escalations once its local time passes ESCALATION_HOUR.
ESCALATIONS_ENABLED=true
ESCALATION_HOUR=6

# ── Local development ─────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lookahead
PORT=4000
APP_URL=http://localhost:5173
# dev = pick a seeded user (local only; refused when NODE_ENV=production)
AUTH_MODE=dev

# ── Production (see docs/DEPLOY.md) ───────────────────────────────
# NODE_ENV=production
# AUTH_MODE=supabase
# DATABASE_URL=<Supabase session pooler connection string, port 5432>
# DATABASE_SSL=true
# DATABASE_CA_CERT=<optional: Supabase CA certificate (PEM) to verify the server certificate>
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_JWT_SECRET=<optional: legacy JWT secret; leave empty to verify with the project's signing keys>
# APP_URL=https://<your web app domain>
# CORS_ORIGIN=<optional: comma-separated origins; defaults to APP_URL's origin in production>
# PROJECT_CREATOR_EMAILS=<comma-separated emails allowed to create projects>
# CRON_SECRET=<random string; enables POST /api/cron/escalations>

# Email (FR-05). Leave SMTP_HOST empty to log emails instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Lookahead <no-reply@example.com>"

# Hourly scheduler; each project's escalations run once its local time passes ESCALATION_HOUR.
ESCALATIONS_ENABLED=true
ESCALATION_HOUR=6

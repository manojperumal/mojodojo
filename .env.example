# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/pensive_post

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── Twilio (SMS delivery) ────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567

# ─── Email delivery ───────────────────────────────────────────────────────────
# SendGrid (recommended)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Generic SMTP (alternative to SendGrid — uncomment to use)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=user@example.com
# SMTP_PASS=password

FROM_EMAIL=noreply@pensivepost.com

# ─── Tango Card (gift card fulfillment) ───────────────────────────────────────
TANGO_PLATFORM_NAME=your_tango_platform_name
TANGO_PLATFORM_KEY=your_tango_platform_key
# Set to true to use mock Tango responses (no real credentials needed)
TANGO_MOCK=true

# ─── Encryption ───────────────────────────────────────────────────────────────
# 64-character hex string (32 bytes) for AES-256-CBC gift card code encryption
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-64-char-hex-encryption-key-here-generate-with-openssl

# ─── App ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
PORT=3001
NODE_ENV=development
